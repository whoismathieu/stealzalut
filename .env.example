# =============================================================================
# StealZaLut — Environment Configuration
# =============================================================================
# Copy this file to `.env` and adjust values to your local setup.
# All variables are optional; sensible defaults are used when absent.
# =============================================================================

# ---------------------------------------------------------------------------
# LUT Export
# ---------------------------------------------------------------------------
# Default grid resolution for the 3D LUT (common values: 17, 33, 64).
# Higher values yield smoother gradients but larger .cube files.
LUT_DEFAULT_SIZE=33

# Default output directory for exported .cube files.
# Leave empty to use the system "Documents" folder.
LUT_OUTPUT_DIR=

# ---------------------------------------------------------------------------
# Color Transfer Engine
# ---------------------------------------------------------------------------
# Algorithm used by color-matcher.
# Supported: "default", "mkl" (Monge–Kantorovitch linear), "hm", "reinhard"
COLOR_TRANSFER_METHOD=mkl

# ---------------------------------------------------------------------------
# GUI
# ---------------------------------------------------------------------------
# Application theme: "dark" | "light"
APP_THEME=dark

# Maximum preview thumbnail size (pixels, longest edge).
PREVIEW_MAX_SIZE=512

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty to log to stdout only).
LOG_FILE=

