/* =============================================================================
   StealZaLut — Dark Theme Stylesheet
   ============================================================================= */

/* ── Global window & fonts ─────────────────────────────────────────────────── */
QMainWindow, QWidget#centralWidget {
    background-color: #1a1b1e;
    color: #e0e2e6;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: transparent;
    color: #e0e2e6;
}

/* ── Group boxes ───────────────────────────────────────────────────────────── */
QGroupBox {
    font-weight: 600;
    font-size: 13px;
    border: 1px solid #2e3238;
    border-radius: 8px;
    margin-top: 22px;
    padding-top: 10px;
    background-color: #212429;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    color: #9da5b4;
    background-color: #1a1b1e;
    border-radius: 4px;
}

/* ── Drop zones & Preview panels ───────────────────────────────────────────── */
#dropZoneLabel {
    border: 2px dashed #3a3f4b;
    border-radius: 6px;
    background-color: #16181b;
    color: #8a919e;
    font-size: 13px;
    padding: 16px;
}

#dropZoneLabel:hover {
    border-color: #4f80ff;
    color: #c0c6d4;
    background-color: #1c1f26;
}

#previewImage {
    border: 1px solid #2e3238;
    border-radius: 6px;
    background-color: #16181b;
    color: #6c7280;
    font-size: 13px;
    padding: 8px;
}

/* ── Splitter ──────────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #2e3238;
    width: 2px;
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #4f80ff;
}

/* ── Controls & Combo Box ──────────────────────────────────────────────────── */
#controlLabel {
    font-weight: 600;
    color: #c0c6d4;
}

QComboBox {
    background-color: #282c34;
    border: 1px solid #3e4451;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 130px;
    color: #e0e2e6;
    font-weight: 500;
}

QComboBox:hover {
    border-color: #4f80ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #3e4451;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #212429;
    border: 1px solid #3e4451;
    selection-background-color: #3b5998;
    selection-color: #ffffff;
    color: #e0e2e6;
    padding: 4px;
    outline: none;
}

/* ── Push Buttons ──────────────────────────────────────────────────────────── */
QPushButton {
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 13px;
    border: 1px solid transparent;
}

#exportButton {
    background-color: #2d6cdf;
    color: #ffffff;
}

#exportButton:hover {
    background-color: #3b7ced;
}

#exportButton:pressed {
    background-color: #2358b5;
}

#exportButton:disabled {
    background-color: #282c34;
    color: #555b68;
    border: 1px solid #343842;
}

#clearButton {
    background-color: #2c313a;
    color: #abb2bf;
    border: 1px solid #3e4451;
}

#clearButton:hover {
    background-color: #353b45;
    color: #ffffff;
    border-color: #4e5666;
}

#clearButton:pressed {
    background-color: #21252b;
}

/* ── Progress Bar ──────────────────────────────────────────────────────────── */
QProgressBar {
    border: 1px solid #2e3238;
    border-radius: 5px;
    text-align: center;
    background-color: #16181b;
    color: #e0e2e6;
    font-weight: 600;
    height: 18px;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #2d6cdf,
        stop: 1 #4f80ff
    );
    border-radius: 4px;
}

/* ── Status Bar ────────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #16181b;
    color: #8a919e;
    border-top: 1px solid #252830;
    font-size: 12px;
    padding: 2px 8px;
}
