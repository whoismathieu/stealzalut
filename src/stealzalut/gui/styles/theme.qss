/* =============================================================================
   StealZaLut — Dark Theme Stylesheet
   ============================================================================= */

/* ── Global window & fonts ─────────────────────────────────────────────────── */
QMainWindow, QWidget#centralWidget {
    background-color: #1a1b1e;
    color: #e0e2e6;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: transparent;
    color: #e0e2e6;
}

/* ── Group boxes ───────────────────────────────────────────────────────────── */
QGroupBox {
    font-weight: 600;
    font-size: 13px;
    border: 1px solid #2e3238;
    border-radius: 8px;
    margin-top: 22px;
    padding-top: 10px;
    background-color: #212429;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    color: #9da5b4;
    background-color: #1a1b1e;
    border-radius: 4px;
}

/* ── Drop zones & Preview panels ───────────────────────────────────────────── */
#dropZoneLabel {
    border: 2px dashed #3a3f4b;
    border-radius: 6px;
    background-color: #16181b;
    color: #8a919e;
    font-size: 13px;
    padding: 16px;
}

#dropZoneLabel:hover {
    border-color: #4f80ff;
    color: #c0c6d4;
    background-color: #1c1f26;
}

#pathField {
    background-color: #16181b;
    border: 1px solid #2e3238;
    border-radius: 4px;
    color: #9da5b4;
    font-family: Consolas, "Cascadia Mono", Menlo, monospace;
    font-size: 11px;
    padding: 3px 6px;
    selection-background-color: #3b5998;
    selection-color: #ffffff;
}

#pathField:focus {
    border-color: #4f80ff;
}

#copyPathButton {
    background-color: #282c34;
    border: 1px solid #3e4451;
    border-radius: 4px;
    color: #c0c6d4;
    font-size: 11px;
    padding: 3px 10px;
}

#copyPathButton:hover {
    border-color: #4f80ff;
    color: #ffffff;
}

#previewImage {
    border: 1px solid #2e3238;
    border-radius: 6px;
    background-color: #16181b;
    color: #6c7280;
    font-size: 13px;
    padding: 8px;
}

/* ── Splitter ──────────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #2e3238;
    width: 2px;
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #4f80ff;
}

/* ── Controls & Combo Box ──────────────────────────────────────────────────── */
#controlLabel {
    font-weight: 600;
    color: #c0c6d4;
}

QComboBox {
    background-color: #282c34;
    border: 1px solid #3e4451;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 130px;
    color: #e0e2e6;
    font-weight: 500;
}

QComboBox:hover {
    border-color: #4f80ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #3e4451;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #212429;
    border: 1px solid #3e4451;
    selection-background-color: #3b5998;
    selection-color: #ffffff;
    color: #e0e2e6;
    padding: 4px;
    outline: none;
}

/* ── Push Buttons ──────────────────────────────────────────────────────────── */
QPushButton {
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 13px;
    border: 1px solid transparent;
}

#exportButton {
    background-color: #2d6cdf;
    color: #ffffff;
}

#exportButton:hover {
    background-color: #3b7ced;
}

#exportButton:pressed {
    background-color: #2358b5;
}

#exportButton:disabled {
    background-color: #282c34;
    color: #555b68;
    border: 1px solid #343842;
}

#clearButton {
    background-color: #2c313a;
    color: #abb2bf;
    border: 1px solid #3e4451;
}

#clearButton:hover {
    background-color: #353b45;
    color: #ffffff;
    border-color: #4e5666;
}

#clearButton:pressed {
    background-color: #21252b;
}

/* ── Progress Bar ──────────────────────────────────────────────────────────── */
QProgressBar {
    border: 1px solid #2e3238;
    border-radius: 5px;
    text-align: center;
    background-color: #16181b;
    color: #e0e2e6;
    font-weight: 600;
    height: 18px;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #2d6cdf,
        stop: 1 #4f80ff
    );
    border-radius: 4px;
}

/* ── Status Bar ────────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #16181b;
    color: #8a919e;
    border-top: 1px solid #252830;
    font-size: 12px;
    padding: 2px 8px;
}

/* ── Adjustments panel ─────────────────────────────────────────────────────── */
#adjustLabel {
    color: #c0c6d4;
    font-size: 12px;
}

#adjustValue {
    color: #9da5b4;
    font-family: Consolas, "Cascadia Mono", Menlo, monospace;
    font-size: 11px;
}

#adjustmentsPanel QSlider::groove:horizontal {
    height: 4px;
    background: #2e3238;
    border-radius: 2px;
}

#adjustmentsPanel QSlider::sub-page:horizontal {
    background: #4f80ff;
    border-radius: 2px;
}

#adjustmentsPanel QSlider::handle:horizontal {
    background: #e0e2e6;
    border: 1px solid #3e4451;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

#adjustmentsPanel QSlider::handle:horizontal:hover {
    background: #ffffff;
    border-color: #4f80ff;
}

#resetAdjustmentsButton {
    background-color: #282c34;
    border: 1px solid #3e4451;
    color: #c0c6d4;
    padding: 4px 12px;
    font-size: 12px;
}

#resetAdjustmentsButton:hover {
    border-color: #4f80ff;
    color: #ffffff;
}

/* ── Correspondence editor ─────────────────────────────────────────────────── */
#correspondenceView {
    background-color: #16181b;
    border-radius: 6px;
}

#correspondenceScroll, #inspectorScroll {
    background-color: transparent;
}

#conflictBanner {
    background-color: #3a2a14;
    color: #ffcc80;
    border-left: 3px solid #ff9f43;
    border-radius: 4px;
    padding: 6px 10px;
}

#inspectorTitle {
    color: #e0e2e6;
    font-size: 13px;
}

#inspectorHint {
    color: #8a919e;
    padding: 12px 0;
}

#inspectorSection {
    color: #9da5b4;
    font-weight: 600;
    padding-top: 4px;
}

#inspectorRationale {
    color: #c4b5fd;
}

#zoneInspector QSlider::groove:horizontal, #tauSlider::groove:horizontal {
    height: 4px;
    background: #3a3f4b;
    border-radius: 2px;
}

#zoneInspector QSlider::sub-page:horizontal, #tauSlider::sub-page:horizontal {
    background: #4f80ff;
    border-radius: 2px;
}

#zoneInspector QSlider::handle:horizontal, #tauSlider::handle:horizontal {
    background: #e0e2e6;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

#zoneInspector QSlider::handle:horizontal:disabled {
    background: #5c6370;
}

#undoButton, #redoButton, #allAutoButton, #revertZoneButton,
#aiPackButton, #importRecipeButton, #exportRecipeButton {
    background-color: #282c34;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
    color: #c0c6d4;
    padding: 4px 10px;
}

#undoButton:hover, #redoButton:hover, #allAutoButton:hover, #revertZoneButton:hover,
#aiPackButton:hover, #importRecipeButton:hover, #exportRecipeButton:hover {
    border-color: #4f80ff;
    color: #ffffff;
}

#undoButton:disabled, #redoButton:disabled, #revertZoneButton:disabled,
#aiPackButton:disabled, #importRecipeButton:disabled, #exportRecipeButton:disabled {
    color: #5c6370;
    border-color: #2e3238;
}

QSpinBox {
    background-color: #282c34;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
    color: #e0e2e6;
    padding: 3px 6px;
}

/* ── Dialogs (paste AI answer, message boxes) ──────────────────────────────── */
QDialog, QMessageBox {
    background-color: #1a1b1e;
}

QPlainTextEdit {
    background-color: #16181b;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
    color: #e0e2e6;
    font-family: Consolas, "Cascadia Mono", Menlo, monospace;
    font-size: 12px;
    selection-background-color: #3b5998;
}

QPlainTextEdit:focus {
    border-color: #4f80ff;
}

QDialog QPushButton {
    background-color: #282c34;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
    color: #e0e2e6;
    padding: 5px 14px;
    min-width: 70px;
}

QDialog QPushButton:hover {
    border-color: #4f80ff;
    color: #ffffff;
}

QMenu {
    background-color: #282c34;
    border: 1px solid #3a3f4b;
    color: #e0e2e6;
    padding: 4px;
}

QMenu::item {
    padding: 5px 18px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #3b5998;
}

QMenu::item:disabled {
    color: #5c6370;
}

/* ── Bottom tabs (adjustments / finishing) ─────────────────────────────────── */
#bottomTabs::pane {
    border: 1px solid #2e3238;
    border-radius: 8px;
    background-color: #212429;
    top: -1px;
}

#bottomTabs QTabBar::tab {
    background-color: #1a1b1e;
    color: #9da5b4;
    padding: 6px 16px;
    border: 1px solid #2e3238;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

#bottomTabs QTabBar::tab:selected {
    background-color: #212429;
    color: #e0e2e6;
    font-weight: 600;
}

#finishingPanel QSlider::groove:horizontal {
    height: 4px;
    background: #3a3f4b;
    border-radius: 2px;
}

#finishingPanel QSlider::handle:horizontal {
    background: #e0e2e6;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

#toneCurveEditor {
    border-radius: 6px;
}

#resetCurveButton, #resetFinishingButton {
    background-color: #282c34;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
    color: #c0c6d4;
    padding: 4px 10px;
}

#resetCurveButton:hover, #resetFinishingButton:hover {
    border-color: #4f80ff;
    color: #ffffff;
}

/* ── Monochrome reference hint ─────────────────────────────────────────────── */
#modeHintBar {
    background-color: #1c2740;
    border-left: 3px solid #4f80ff;
    border-radius: 4px;
}

#modeHintLabel {
    color: #c9d6f2;
}

#modeHintButton {
    background-color: #4f80ff;
    border: none;
    border-radius: 4px;
    color: #ffffff;
    padding: 5px 12px;
    font-weight: 600;
}

#modeHintButton:hover {
    background-color: #6a94ff;
}

#modeHintClose {
    color: #9da5b4;
    background: transparent;
    border: none;
    padding: 2px 6px;
}
