/* =============================================================================
   StealZaLut stylesheet: one template for every theme.

   A word starting with an at sign is a token, replaced when the theme is
   applied (gui/theming.py) by the value the theme gives it in
   gui/styles/themes/*.json.  The token "icons" is the folder of the arrows
   and the tick, drawn in the theme's colours.
   To change a colour, edit the theme file, not this one.
   ============================================================================= */

/* Base */
QMainWindow, QMainWindow > QWidget, QDialog, QMessageBox {
    background-color: @bg;
}

QWidget {
    background-color: transparent;
    color: @text;
    font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QWidget:disabled {
    color: @mute;
}

QToolTip {
    background-color: @raised;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 8px;
}

/* Panels */
QGroupBox {
    background-color: @surface;
    border: 1px solid @panel_border;
    border-radius: @radius;
    margin-top: 0px;
    padding: 30px 6px 6px 6px;
    font-size: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 12px;
    top: 9px;
    color: @dim;
    background-color: transparent;
}

/* Images */
#dropZoneLabel {
    border: 1px dashed @border;
    border-radius: @radius_s;
    background-color: @inset;
    color: @mute;
    padding: 12px;
}

#dropZoneLabel:hover {
    border-color: @accent;
    color: @dim;
}

#previewImage {
    border: 1px solid transparent;
    border-radius: @radius_s;
    background-color: @inset;
    color: @mute;
    padding: 8px;
}

#pathField {
    background-color: transparent;
    border: none;
    color: @mute;
    font-size: 11px;
    padding: 3px 2px;
    selection-background-color: @sel;
}

#pathField:focus {
    color: @text;
}

/* Splitter */
QSplitter::handle {
    background-color: transparent;
    width: 6px;
    height: 6px;
}

QSplitter::handle:hover {
    background-color: @border;
}

/* Buttons */
QPushButton {
    background-color: @raised;
    border: 1px solid @border;
    border-radius: @radius_s;
    color: @text;
    padding: 6px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: @raised_hover;
}

QPushButton:pressed {
    background-color: @inset;
}

QPushButton:disabled {
    background-color: transparent;
    color: @mute;
    border-color: @border;
}

#exportButton, #modeHintButton {
    background-color: @accent;
    border-color: @accent;
    color: @accent_text;
    font-weight: 600;
    padding: 6px 16px;
}

#exportButton:hover, #modeHintButton:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}

#exportButton:pressed {
    background-color: @accent_press;
}

#exportButton:disabled {
    background-color: @raised;
    border-color: @border;
    color: @mute;
}

#copyPathButton, #modeHintClose, #collapseButton, #appearanceButton {
    background-color: transparent;
    border: 1px solid transparent;
    color: @dim;
    padding: 3px 8px;
}

#copyPathButton {
    font-size: 11px;
}

#appearanceButton {
    font-size: 12px;
    border-radius: @radius_s;
    padding: 2px 8px;
}

#collapseButton {
    font-size: 15px;
    padding: 2px 6px;
}

#copyPathButton:hover, #modeHintClose:hover, #collapseButton:hover, #appearanceButton:hover {
    background-color: @raised_hover;
    color: @text;
}

/* Fields */
#controlLabel {
    color: @dim;
    font-weight: 500;
}

QComboBox, QSpinBox {
    background-color: @raised;
    border: 1px solid @border;
    border-radius: @radius_s;
    padding: 5px 10px;
    color: @text;
}

QComboBox {
    min-width: 130px;
}

#lutSizeCombo, #cubeSpaceCombo {
    min-width: 60px;
}

QComboBox:hover, QSpinBox:hover {
    background-color: @raised_hover;
}

QComboBox:focus, QSpinBox:focus {
    border-color: @accent;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
}

QComboBox::down-arrow, QSpinBox::down-arrow {
    image: url(@icons/down.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow {
    image: url(@icons/up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView, QMenu {
    background-color: @raised;
    border: 1px solid @border;
    border-radius: @radius_s;
    color: @text;
    padding: 4px;
    outline: none;
    selection-background-color: @sel;
    selection-color: @text;
}

QMenu::item {
    padding: 5px 18px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: @sel;
}

QMenu::item:disabled {
    color: @mute;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @border;
    border-radius: 4px;
    background-color: @raised;
}

QCheckBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
    image: url(@icons/check.svg);
}

QPlainTextEdit {
    background-color: @inset;
    border: 1px solid @border;
    border-radius: @radius_s;
    color: @text;
    font-family: "Cascadia Mono", Consolas, Menlo, monospace;
    font-size: 12px;
    selection-background-color: @sel;
}

QPlainTextEdit:focus {
    border-color: @accent;
}

QDialog QPushButton {
    min-width: 70px;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 2px;
    background: @groove;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    background: @handle;
    border: none;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: @accent_hover;
}

QSlider::handle:horizontal:disabled {
    background: @mute;
}

#adjustmentsPanel QSlider::sub-page:horizontal, #zoneInspector QSlider::sub-page:horizontal,
#tauSlider::sub-page:horizontal, #separationSlider::sub-page:horizontal,
#localitySlider::sub-page:horizontal {
    background: @accent;
    border-radius: 1px;
}

QSlider::sub-page:horizontal:disabled {
    background: @groove;
}

#adjustLabel {
    color: @dim;
    font-size: 12px;
}

#adjustValue {
    color: @mute;
    font-size: 11px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle {
    background: @groove;
    border-radius: 2px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: @mute;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* Progress and status */
QProgressBar {
    border: none;
    border-radius: 1px;
    background-color: @groove;
    color: transparent;
    max-height: 2px;
    min-height: 2px;
}

QProgressBar::chunk {
    background-color: @accent;
    border-radius: 1px;
}

QStatusBar {
    background-color: @bg;
    color: @mute;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* Zones */
#correspondenceView {
    background-color: @inset;
    border-radius: @radius_s;
}

#correspondenceScroll, #inspectorScroll, #panelScroll, #panelScroll > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

#conflictBanner {
    background-color: @warn_bg;
    color: @warn_text;
    border-left: 2px solid @warn;
    border-radius: 4px;
    padding: 6px 10px;
}

#inspectorTitle {
    color: @text;
}

#inspectorHint {
    color: @mute;
    padding: 12px 0;
}

#inspectorSection {
    color: @dim;
    font-weight: 600;
    padding-top: 4px;
}

#inspectorRationale {
    color: @note;
}

/* Bottom tabs */
#bottomTabs::pane {
    border: 1px solid @panel_border;
    border-radius: @radius;
    background-color: @surface;
}

#bottomTabs QTabBar {
    qproperty-drawBase: 0;
    background-color: transparent;
}

#bottomTabs QTabBar::tab {
    background-color: transparent;
    color: @mute;
    padding: 6px 4px;
    margin: 0 10px 4px 4px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}

#bottomTabs QTabBar::tab:hover {
    color: @dim;
}

#bottomTabs QTabBar::tab:selected {
    color: @text;
    border-bottom-color: @accent;
}

#toneCurveEditor {
    border-radius: @radius_s;
}

/* Hints */
#modeHintBar {
    background-color: @hint_bg;
    border: none;
    border-radius: @radius_s;
}

#modeHintLabel {
    color: @hint_text;
    font-size: 12px;
}
